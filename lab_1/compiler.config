############################
#### MANDATORY SETTINGS	####
############################

# List of source files (*.v) to be included in the compilation process.
# Ordering is irrelevant. Use '+=' to add sources after the first one.
VERILOG_SOURCES = neg_counter.v
VERILOG_SOURCES += module_frequencyDivider.v
VERILOG_SOURCES += module_downcounter_8_bit.v

# List of constraint files (*.xdc) to be included in the compilation process.
# Use '+=' to add sources after the first one.
CONSTRAINTS_SOURCES = simpleCounter.xdc

# Name of the top-level module (must be a module existing within the source files).
TOP_LEVEL_MODULE = neg_counter

# Code of the target device chip
TARGET_CHIP = xc7z010clg400-1

############################
#### OPTIONAL SETTINGS	####
############################

# Name of the project, used for the final *.bit file.
# If not specified, a name will be automatically generated as the name of the working directory (uncapitalized).
PROJECT_NAME = simpleCounter

# Path of vivado's executable.
# If not specified, the Makefile will assume that 'vivado' is in the PATH.
VIVADO_EXEC = /usr/LDSS/Vivado/Vivado/2022.1/bin/vivado

####################################################

# This is a configuration file loaded by the compilation Makefile.
# Modify it according to the current project's configuration.
# DO NOT RENAME this file.
# Lines starting with '#' are ignored.

############################
#### MANDATORY SETTINGS	####
############################

# List of source files (*.v) to be included in the compilation process.
# Ordering is irrelevant. Use '+=' to add sources after the first one.
VERILOG_SOURCES = startStopLapResetChrono_OLED.v
VERILOG_SOURCES += Driver_OLED_header.v
VERILOG_SOURCES += chipStore.v

# List of constraint files (*.xdc) to be included in the compilation process.
# Ordering is irrelevant. Use '+=' to add sources after the first one.
CONSTRAINTS_SOURCES = startStopLapResetChrono_OLED.xdc
CONSTRAINTS_SOURCES += Driver_OLED.xdc

# List of pre-synthesized files (*.edf) to be included in the compilation process.
# Ordering is irrelevant. Use '+=' to add sources after the first one.
# WARNING: for each pre-synthesized file, a corresponding header file
#          containing only the module declaration (with its ports)
#          should also be included within the VERILOG_SOURCES.
SYNTHESIZED_SOURCES = Driver_OLED.edf

# Name of the top-level module.
# It must be a module existing within one of the source (.v) files.
TOP_LEVEL_MODULE = startStopLapResetChrono_OLED

# Code of the target device chip.
# This should not be changed.
TARGET_CHIP = xc7z010clg400-1

############################
#### OPTIONAL SETTINGS	####
############################

# Name of the project, used for the final *.bit file.
# If not specified, a name will be automatically generated as
# the name of the working directory.
PROJECT_NAME = startStopLapResetChrono_OLED

# Path of Vivado's executable.
# If not specified, the Makefile will assume that 'vivado' is in the PATH
# of the current shell.
VIVADO_EXEC = /usr/LDSS/Vivado/Vivado/2022.1/bin/vivado
